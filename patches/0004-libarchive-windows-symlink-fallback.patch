+	if (symlink_target_is_absolute(linktarget)) {
+		wchar_t *full;
+		/* Leave drive-relative and root-relative targets to the native API. */
+		if (win_path_root_len(linktarget) == 0)
+			return (ARCHIVE_RETRY);
+		full = __la_win_permissive_name_w(linktarget);
+		if (full == NULL)
+			return (ARCHIVE_RETRY);
+		target = normalize_full_path_w(full);
+		free(full);
+	} else {
+		target = symlink_target_path(p->name, linktarget);
+	}
