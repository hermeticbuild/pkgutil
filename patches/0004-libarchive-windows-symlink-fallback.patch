+		    "Can't inspect symlink target '%ls' -> '%ls'", p->name, linktarget);
+		return (ARCHIVE_FAILED);
+	}
+	/* An explicit hint is authoritative, even if it mismatches the target. */
+	if (*type != AE_SYMLINK_TYPE_FILE && *type != AE_SYMLINK_TYPE_DIRECTORY)
+		*type = (attrs & FILE_ATTRIBUTE_DIRECTORY) ?
+		    AE_SYMLINK_TYPE_DIRECTORY : AE_SYMLINK_TYPE_FILE;
+	return (ARCHIVE_OK);
+}
+
+static int
+create_pending_symlink(struct archive_write_disk *a, struct pending_symlink *p,
+    int type)
+{
+	struct archive saved_error = {0};
+	int r, r2, saved_flags = a->flags;
