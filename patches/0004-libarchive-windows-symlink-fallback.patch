+	archive_entry_set_symlink_type(p->entry, type);
+	a->replaying_symlink = p;
+	/*
+	 * Only the captured, already-validated output pathname is absolute here.
+	 * Recheck the filesystem for intervening links, but do not reject our
+	 * internal absolute pathname as though it were an untrusted archive path.
+	 * The target string is never rewritten.
+	 */
+	a->flags = p->flags & ~ARCHIVE_EXTRACT_SECURE_NOABSOLUTEPATHS;
+	archive_wstring_empty(&a->path_safe);
+	r = _archive_write_disk_header(&a->archive, p->entry);
+	if (r >= ARCHIVE_WARN) {
