+		else if (r != ARCHIVE_OK)
+			archive_copy_error(&a->archive, &saved_error);
+	}
+	archive_string_free(&saved_error.error_string);
+	a->flags = saved_flags;
+	a->replaying_symlink = NULL;
+	return (r);
